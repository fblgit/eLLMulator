{
  "name": "ellmulator",
  "version": "0.1.0",
  "description": "Agentic Distributed Trace Simulation — LLM agents as software components",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "ellmulator": "dist/cli.js"
  },
  "author": "XM.Murias <info@juanako.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fblgit/eLLMulator.git"
  },
  "homepage": "https://github.com/fblgit/eLLMulator#readme",
  "bugs": {
    "url": "https://github.com/fblgit/eLLMulator/issues"
  },
  "keywords": [
    "llm",
    "agents",
    "distributed-tracing",
    "mcp",
    "claude",
    "static-analysis",
    "testing",
    "agentic",
    "simulation"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "prepublishOnly": "npm run build && npm test",
    "clean": "rm -rf dist/"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.72",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "better-sqlite3": "^12.6.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
